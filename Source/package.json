{
    "name": "lens",
    "version": "0.1.0",
    "description": "Browser extension bringing Cratis insights and developer productivity tools to your fingertips.",
    "private": true,
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "build-package": "yarn build && cd .. && zip -r lens-extension.zip Source/dist/",
        "typecheck": "tsc --noEmit",
        "ci": "tsc --noEmit && yarn build",
        "preview": "vite preview"
    },
    "dependencies": {
        "@cratis/arc.react": "^20.26.18",
        "primeicons": "^7.0.0",
        "primereact": "^10.9.8",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-icons": "^5.6.0"
    },
    "devDependencies": {
        "@types/chrome": "^0.0.268",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^6.0.1",
        "typescript": "^7.0.2",
        "vite": "^8.0.10",
        "vite-plugin-web-extension": "^4.5.1"
    },
    "packageManager": "yarn@4.17.1"
}
