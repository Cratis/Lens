{
    "manifest_version": 3,
    "name": "Cratis Lens",
    "version": "1.0.0",
    "description": "Developer tool for Cratis Arc (CQRS for ASP.NET Core): switch tenant and user identity, and run commands and queries in your app.",
    "permissions": [
        "storage",
        "scripting",
        "cookies",
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "index.html",
        "default_title": "Lens",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background/service-worker.ts",
        "type": "module"
    }
}
